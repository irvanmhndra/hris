DATABASE_URL=postgres://hris:hris_local@localhost:5440/hris?sslmode=disable
HTTP_ADDR=:8088
# Comma-separated origins; leave empty when the web apps reach /api same-origin (Vite proxy / reverse proxy).
CORS_ALLOWED_ORIGINS=
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
# Self-service company sign-up (POST /auth/register).
SIGNUP_ENABLED=false
# Portal URLs used in emailed links (password reset).
ADMIN_URL=http://127.0.0.1:5180
EMPLOYEE_URL=http://127.0.0.1:5181
# Uploaded documents (local disk; back this directory up).
UPLOAD_DIR=data/uploads
# SMTP for password-reset email. Empty SMTP_HOST logs emails instead (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=People HRIS <no-reply@localhost>
